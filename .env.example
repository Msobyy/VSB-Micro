# Shared infra config, loaded by every service via @vsb/config (root .env is
# a fallback layer — each service's own .env, if present, wins on overlap).
# `docker compose -f infra/docker-compose.dev.yaml up` sets these directly as
# container env vars and does not read this file.

NODE_ENV=development

# --- Kafka / Redpanda ---
# localhost:19092 = Redpanda's external listener, for host-side processes.
# Containers on the compose network use redpanda:9092 instead (set in
# docker-compose.dev.yaml per-service, not here).
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=vsb-microservices

# --- Mongo ---
# Must point at a replica-set-enabled Mongo (required for @vsb/event-bus's
# outbox transactions + change streams) — a plain standalone `mongod` will
# fail. If you're running a service outside Docker against the dockerized
# Mongo (`docker compose up mongo mongo-init`), add "127.0.0.1 mongo" to
# /etc/hosts first: the replica set's member is registered as "mongo:27017"
# so the driver needs that hostname to resolve, not just the exposed port.
MONGO_URI=mongodb://mongo:27017/?replicaSet=rs0

# --- Redis (shared instance for dev; separate key prefix per service) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Auth (matches vsb-backend's shared-secret pattern for the CRM/admin surface) ---
JWT_SECRET=dev-secret-change-me

# --- Service ports + URLs are service-specific — see each
# services/<name>/.env.example rather than duplicating them here.
