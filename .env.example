# Shared infra config, loaded by every service via @vsb/config (root .env is
# a fallback layer — each service's own .env, if present, wins on overlap).
# `docker compose -f infra/docker-compose.dev.yaml up` sets most of these
# directly as container env vars and does not read this file — the
# exceptions are MONGO_URI and REDIS_* (see below), which docker-compose
# interpolates straight out of a real `.env` you create alongside this one.

NODE_ENV=development

# --- Kafka / Redpanda ---
# localhost:19092 = Redpanda's external listener, for host-side processes.
# Containers on the compose network use redpanda:9092 instead (set in
# docker-compose.dev.yaml per-service, not here).
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=vsb-microservices

# --- Mongo ---
# Managed MongoDB Atlas, same as production — not a local container. See
# docs/architecture-decision-records/0007-mongodb-atlas-not-self-hosted.md.
# Use a dedicated test/dev cluster, not the production one. Full
# mongodb+srv:// connection string, credentials included; each service
# picks its own database name within it via its own config (unchanged).
MONGO_URI=

# --- Redis ---
# Managed Redis Cloud, same as production — not a local container. See
# docs/architecture-decision-records/0006-redis-cloud-per-service-ownership.md.
# Each service picks its own REDIS_DB index and keyPrefix for isolation
# (see that service's own config.js). Leave blank to fall back to an
# unauthenticated localhost Redis if you happen to have one running.
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# --- Auth (matches vsb-backend's shared-secret pattern for the CRM/admin surface) ---
JWT_SECRET=dev-secret-change-me

# --- Service ports + URLs are service-specific — see each
# services/<name>/.env.example rather than duplicating them here.
