# Service-specific overrides. Copy to .env for standalone (non-docker) runs
# from this directory — merged on top of the repo-root .env by @vsb/config.
PORT=3002

# --- Push provider ---
# "firebase" or "console". Defaults to "firebase" automatically once the
# three FIREBASE_* vars below are all set, otherwise "console" (logs
# instead of sending) — set this explicitly to override that auto-pick.
# PUSH_PROVIDER=console

# Same variable names as vsb-backend/config/index.js's firebaseConfig, so a
# real deployment can reuse the same secrets. Leave unset for local dev —
# the service falls back to the console provider automatically.
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=
