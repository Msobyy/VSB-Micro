# Service-specific overrides. Copy to .env for standalone (non-docker) runs
# from this directory — merged on top of the repo-root .env by @vsb/config.
PORT=3004

# --- OTP channels ---
# Both SMS and WhatsApp are active by default (a client picks per-request
# via the is_whatsapp flag on send-otp — same as the original mobile API).
# Each channel independently falls back to console (logs the code instead
# of sending) if its own credentials below aren't set. Comma-separated —
# remove a channel entirely (not even a console fallback) by excluding it.
# OTP_CHANNELS=sms,whatsapp

# Same variable names as vsb-backend/config/index.js, so a real deployment
# can reuse the same secrets. Leave unset for local dev.
# JAZZ_USERNAME=
# JAZZ_PASSWORD=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_NUMBER_ID=

# Lets a fixed set of QA/app-store-reviewer numbers skip real OTP delivery
# (see src/services/passengerAuthService.js) — off by default, unlike the
# original vsb-backend controllers where this was unconditionally on.
# ENABLE_TEST_OTP_BYPASS=true

# This service's index on the shared Redis Cloud instance (see root
# .env.example + ADR 0006) — every service claims its own, don't reuse.
# REDIS_DB=0
